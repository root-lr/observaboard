# ObservaBoard rules — generated by `observa central install|reload`.
# Convention: every series carries project, env, service (and host for agents).
# Thresholds come from observa.yaml (observa_service_threshold metric published
# by `observa apply`) or, failing that, from the presets' default values.
# Notification routing comes from observa_service_info (notify_critical/notify_warning).
groups:
  # -------------------------------------------------------------------------
  - name: observa-inventory
    interval: 30s
    rules:
      - record: observa:service:last_seen_timestamp
        expr: max by (project, env, service, host) (max_over_time(container_last_seen{service!=""}[1d]))

      - record: observa:service:present
        expr: |
          max by (project, env, service) (observa:service:last_seen_timestamp) * 0 + 1
          or on (project, env, service)
          max by (project, env, service) (rate(traces_spanmetrics_calls_total{span_kind="SPAN_KIND_SERVER", project!=""}[1h])) * 0 + 1
          or on (project, env, service)
          max by (project, env, service) (pg_up{service!=""}) * 0 + 1
          or on (project, env, service)
          max by (project, env, service) (redis_up{service!=""}) * 0 + 1

      - record: observa:service:routing
        expr: |
          # topk: a single series per service, even if two agents publish different
          # channels (rollout of a modified observa.yaml in progress).
          max by (project, env, service, notify_critical, notify_warning) (
            topk by (project, env, service) (1, observa_service_info)
          )
          or on (project, env, service)
          observa:service:present

  # -------------------------------------------------------------------------
  - name: observa-thresholds
    interval: 30s
    rules:
[[- range .Params]]
      # [[.Key]] in observa.yaml (default [[.Default]])
      - record: observa:threshold:[[.Metric]]
        expr: |
          max by (project, env, service) (observa_service_threshold{threshold="[[.Metric]]"})
          or on (project, env, service)
          (observa:service:present * 0 + [[.DefaultMetricValue]])
[[- end]]

  # -------------------------------------------------------------------------
  - name: observa-http
    interval: 30s
    rules:
      # Source: Tempo span metrics (server spans), see tempo.yaml.
      - record: observa:http_requests:rate5m
        expr: sum by (project, env, service) (rate(traces_spanmetrics_calls_total{span_kind="SPAN_KIND_SERVER", project!=""}[5m]))

      - record: observa:http_errors:rate5m
        expr: sum by (project, env, service) (rate(traces_spanmetrics_calls_total{span_kind="SPAN_KIND_SERVER", project!="", http_response_status_code=~"5.."}[5m]))

      - record: observa:http_error_ratio:rate5m
        expr: |
          (observa:http_errors:rate5m or observa:http_requests:rate5m * 0)
          / on (project, env, service)
          observa:http_requests:rate5m

      - record: observa:http_latency_p95:5m
        expr: histogram_quantile(0.95, sum by (project, env, service, le) (rate(traces_spanmetrics_latency_bucket{span_kind="SPAN_KIND_SERVER", project!=""}[5m])))

  # -------------------------------------------------------------------------
  - name: observa-celery
    interval: 30s
    rules:
      - record: observa:celery_tasks:rate10m
        expr: sum by (project, env, service) (rate(traces_spanmetrics_calls_total{span_kind="SPAN_KIND_CONSUMER", project!=""}[10m]))

      - record: observa:celery_task_failures:rate10m
        expr: sum by (project, env, service) (rate(traces_spanmetrics_calls_total{span_kind="SPAN_KIND_CONSUMER", project!="", status_code="STATUS_CODE_ERROR"}[10m]))

      - record: observa:celery_task_failure_ratio:rate10m
        expr: |
          (observa:celery_task_failures:rate10m or observa:celery_tasks:rate10m * 0)
          / on (project, env, service)
          observa:celery_tasks:rate10m

  # -------------------------------------------------------------------------
  - name: observa-alerts-services
    rules:
      - alert: ObservaServiceDown
        expr: |
          (time() - observa:service:last_seen_timestamp > 120)
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }} is no longer running on {{ $labels.host }}"
          description: "The container has not been seen for {{ $value | humanizeDuration }}."
          runbook_url: "[[.BaseURL]]/runbooks/observa-service-down"
          dashboard_url: "[[.BaseURL]]/d/observa-container?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaContainerRestarting
        expr: |
          (changes(container_start_time_seconds{service!=""}[15m]) >= 3)
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }} is restarting in a loop"
          description: "{{ $value }} restarts in 15 minutes on {{ $labels.host }}."
          runbook_url: "[[.BaseURL]]/runbooks/observa-container-restarting"
          dashboard_url: "[[.BaseURL]]/d/observa-container?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaHighErrorRate
        expr: |
          (
            (observa:http_error_ratio:rate5m > on (project, env, service) observa:threshold:http_error_ratio)
            and on (project, env, service)
            (observa:http_requests:rate5m > 0.05)
          )
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: {{ $value | humanizePercentage }} 5xx responses"
          description: "The share of 5xx responses has been above the threshold for 5 minutes."
          runbook_url: "[[.BaseURL]]/runbooks/observa-high-error-rate"
          dashboard_url: "[[.BaseURL]]/d/observa-http?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaHighLatency
        expr: |
          (
            (observa:http_latency_p95:5m > on (project, env, service) observa:threshold:http_latency_p95_seconds)
            and on (project, env, service)
            (observa:http_requests:rate5m > 0.05)
          )
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: p95 latency of {{ $value | humanizeDuration }}"
          description: "The p95 latency has been above the threshold for 10 minutes."
          runbook_url: "[[.BaseURL]]/runbooks/observa-high-latency"
          dashboard_url: "[[.BaseURL]]/d/observa-http?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaCeleryTaskFailures
        expr: |
          (
            (observa:celery_task_failure_ratio:rate10m > on (project, env, service) observa:threshold:celery_task_failure_ratio)
            and on (project, env, service)
            (observa:celery_tasks:rate10m > 0.002)
          )
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: {{ $value | humanizePercentage }} failed tasks"
          description: "The share of failed Celery tasks has been above the threshold for 10 minutes."
          runbook_url: "[[.BaseURL]]/runbooks/observa-celery-task-failures"
          dashboard_url: "[[.BaseURL]]/d/observa-celery?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

  # -------------------------------------------------------------------------
  - name: observa-alerts-datastores
    rules:
      - alert: ObservaPostgresDown
        expr: |
          (max by (project, env, service) (pg_up) == 0)
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: PostgreSQL unreachable"
          description: "The agent's exporter can no longer connect to the database."
          runbook_url: "[[.BaseURL]]/runbooks/observa-postgres-down"
          dashboard_url: "[[.BaseURL]]/d/observa-postgres?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaPostgresConnectionsHigh
        expr: |
          (
            sum by (project, env, service) (pg_stat_activity_count)
            / on (project, env, service)
            max by (project, env, service) (pg_settings_max_connections)
            > on (project, env, service) observa:threshold:postgres_connections_ratio
          )
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: {{ $value | humanizePercentage }} of PostgreSQL connections in use"
          description: "The number of connections is approaching max_connections."
          runbook_url: "[[.BaseURL]]/runbooks/observa-postgres-connections-high"
          dashboard_url: "[[.BaseURL]]/d/observa-postgres?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaRedisDown
        expr: |
          (max by (project, env, service) (redis_up) == 0)
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: Redis unreachable"
          description: "The agent's exporter can no longer connect to Redis."
          runbook_url: "[[.BaseURL]]/runbooks/observa-redis-down"
          dashboard_url: "[[.BaseURL]]/d/observa-redis?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaRedisMemoryHigh
        expr: |
          (
            max by (project, env, service) (redis_memory_used_bytes)
            / on (project, env, service)
            max by (project, env, service) (redis_memory_max_bytes > 0)
            > on (project, env, service) observa:threshold:redis_memory_ratio
          )
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}/{{ $labels.service }}: Redis at {{ $value | humanizePercentage }} of maxmemory"
          description: "Beyond it, Redis evicts keys or refuses writes depending on its policy."
          runbook_url: "[[.BaseURL]]/runbooks/observa-redis-memory-high"
          dashboard_url: "[[.BaseURL]]/d/observa-redis?var-project={{ $labels.project }}&var-env={{ $labels.env }}&var-service={{ $labels.service }}"

      - alert: ObservaQueueBacklog
        expr: |
          (
            max by (project, env, service) (redis_key_size{key="celery"})
            > on (project, env, service) observa:threshold:queue_length
          )
          * on (project, env, service) group_left (notify_critical, notify_warning)
          observa:service:routing
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.project }}/{{ $labels.env }}: {{ $value }} tasks waiting in the Celery queue"
          description: "The `celery` queue on {{ $labels.service }} has been growing for 10 minutes: the workers cannot keep up."
          runbook_url: "[[.BaseURL]]/runbooks/observa-queue-backlog"
          dashboard_url: "[[.BaseURL]]/d/observa-celery?var-project={{ $labels.project }}&var-env={{ $labels.env }}"

  # -------------------------------------------------------------------------
  - name: observa-alerts-hosts
    rules:
      - alert: ObservaAgentSilent
        expr: |
          count by (host) (max_over_time(node_boot_time_seconds{job="observa/host"}[1d]))
          unless on (host)
          count by (host) (node_boot_time_seconds{job="observa/host"})
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Agent {{ $labels.host }} is no longer sending data"
          description: "No data received for more than 5 minutes: server down, agent stopped or network cut."
          runbook_url: "[[.BaseURL]]/runbooks/observa-agent-silent"
          dashboard_url: "[[.BaseURL]]/d/observa-host?var-host={{ $labels.host }}"

      - alert: ObservaHostDiskFull
        expr: |
          1 - (
            node_filesystem_avail_bytes{job="observa/host", fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|fuse.*", mountpoint!~"/(run|var/lib/docker|snap)($|/.*)"}
            / node_filesystem_size_bytes{job="observa/host", fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|fuse.*", mountpoint!~"/(run|var/lib/docker|snap)($|/.*)"}
          ) > 0.85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.host }}: disk {{ $labels.mountpoint }} {{ $value | humanizePercentage }} full"
          description: "Beyond 95%, databases, logs and Docker may crash."
          runbook_url: "[[.BaseURL]]/runbooks/observa-host-disk-full"
          dashboard_url: "[[.BaseURL]]/d/observa-host?var-host={{ $labels.host }}"

      - alert: ObservaHostMemoryHigh
        expr: |
          1 - (node_memory_MemAvailable_bytes{job="observa/host"} / node_memory_MemTotal_bytes{job="observa/host"}) > 0.90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.host }}: {{ $value | humanizePercentage }} memory used"
          description: "The kernel may start killing processes (OOM killer)."
          runbook_url: "[[.BaseURL]]/runbooks/observa-host-memory-high"
          dashboard_url: "[[.BaseURL]]/d/observa-host?var-host={{ $labels.host }}"

  # -------------------------------------------------------------------------
  - name: observa-alerts-central
    rules:
      - alert: ObservaCentralDegraded
        expr: up{job="observa-central"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "ObservaBoard central: {{ $labels.component }} is not responding"
          description: "Some data (metrics, logs or traces) is no longer received or viewable."
          runbook_url: "[[.BaseURL]]/runbooks/observa-central-degraded"
          dashboard_url: "[[.BaseURL]]/d/observa-overview"

      # Always-firing alert: proves the alerting pipeline works.
      # Sent only to the external heartbeat if notifications.heartbeat_url is set.
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "ObservaBoard watchdog: the alerting pipeline works"
