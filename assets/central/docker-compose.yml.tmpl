# ObservaBoard central — generated by `observa central install|reload`.
# Do not edit by hand: edit central.yaml, then run `observa central reload`.
# Only Caddy publishes ports; the other components stay on the internal network.
name: observa-central

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  caddy:
    image: {{.Images.Caddy}}
    container_name: observa-caddy
    restart: unless-stopped
    ports:
{{- range .Ports}}
      - "{{.}}"
{{- end}}
    volumes:
      # Directories (not single files): hot reloads see the new versions.
      - ./caddy:/etc/caddy:ro
      - ./runbooks:/srv/runbooks:ro
      - caddy-data:/data
      - caddy-config:/config
    networks: [internal, observa]
    depends_on: [grafana, prometheus, loki, tempo]
    logging: *logging

  grafana:
    image: {{.Images.Grafana}}
    container_name: observa-grafana
    restart: unless-stopped
    env_file: .env
    environment:
      GF_SERVER_ROOT_URL: "{{.BaseURL}}"
      GF_SECURITY_ADMIN_USER: "{{.AdminUser}}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /var/lib/grafana/dashboards/ObservaBoard/observa-overview.json
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana
    networks: [internal]
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://localhost:3000/api/health || curl -fsS http://localhost:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 5
    logging: *logging

  prometheus:
    image: {{.Images.Prometheus}}
    container_name: observa-prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-remote-write-receiver
      - --web.enable-lifecycle
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus-data:/prometheus
    networks: [internal]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O-", "http://localhost:9090/-/ready"]
      interval: 30s
      timeout: 5s
      retries: 5
    logging: *logging

  alertmanager:
    image: {{.Images.Alertmanager}}
    container_name: observa-alertmanager
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.external-url={{.BaseURL}}
      - --web.route-prefix=/
    volumes:
      - ./alertmanager:/etc/alertmanager:ro
      - alertmanager-data:/alertmanager
    networks: [internal]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O-", "http://localhost:9093/-/ready"]
      interval: 30s
      timeout: 5s
      retries: 5
    logging: *logging

  loki:
    image: {{.Images.Loki}}
    container_name: observa-loki
    restart: unless-stopped
    command: ["-config.file=/etc/loki/loki.yaml"]
    volumes:
      - ./loki:/etc/loki:ro
      - loki-data:/loki
    networks: [internal]
    healthcheck:
      test: ["CMD", "/usr/bin/loki", "-health"]
      interval: 30s
      timeout: 5s
      retries: 5
    logging: *logging

  tempo:
    image: {{.Images.Tempo}}
    container_name: observa-tempo
    restart: unless-stopped
    command: ["-target=all", "-config.file=/etc/tempo/tempo.yaml"]
    volumes:
      - ./tempo:/etc/tempo:ro
      - tempo-data:/var/tempo
    networks: [internal]
    healthcheck:
      test: ["CMD", "/tempo", "-health"]
      interval: 30s
      timeout: 5s
      retries: 5
    logging: *logging

volumes:
  caddy-data: {}
  caddy-config: {}
  grafana-data: {}
  prometheus-data: {}
  alertmanager-data: {}
  loki-data: {}
  tempo-data: {}

networks:
  internal: {}
  observa:
    external: true
