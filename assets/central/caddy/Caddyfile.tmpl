# ObservaBoard central Caddy — generated by `observa central install|reload`.
# Single entry point: Grafana, runbooks, and ingestion of agent data
# (/ingest/*, protected by agent ID + token).
{
	admin localhost:2019
{{- if .Email}}
	email {{.Email}}
{{- end}}
}

(agents) {
{{- if .Tokens}}
	basic_auth bcrypt "ObservaBoard ingest" {
{{- range .Tokens}}
		{{.Name}} {{.Hash}}
{{- end}}
	}
{{- else}}
	# No active token: all ingestion is rejected (observa token create).
	respond "no active token" 401
{{- end}}
}

{{.SiteAddress}} {
	encode zstd gzip

	handle /ingest/ping {
		import agents
		respond "ok" 200
	}

	handle_path /ingest/prometheus/* {
		import agents
		rewrite * /api/v1/write
		reverse_proxy prometheus:9090
	}

	handle_path /ingest/loki/* {
		import agents
		rewrite * /loki/api/v1/push
		reverse_proxy loki:3100
	}

	handle_path /ingest/otlp/* {
		import agents
		reverse_proxy tempo:4318
	}

	handle /ingest/* {
		respond 404
	}

	handle_path /runbooks/* {
		root * /srv/runbooks
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle {
		reverse_proxy grafana:3000
	}
}
