// ObservaBoard agent configuration (Grafana Alloy {{.AlloyVersion}}).
// Generated by `observa` — do not edit by hand: run `observa agent reload` instead.
// Server: {{.Host}} — central: {{.CentralURL}}

logging {
  level  = "info"
  format = "logfmt"
}

// ---------------------------------------------------------------------------
// Shipping to the central (HTTPS + agent ID + token)
// ---------------------------------------------------------------------------

prometheus.remote_write "central" {
  external_labels = { host = {{q .Host}} }

  endpoint {
    url = {{q (print .CentralURL "/ingest/prometheus/write")}}

    basic_auth {
      username = {{q .AgentName}}
      password = sys.env("OBSERVA_TOKEN")
    }
{{tlsConfig .TLS "    "}}
  }

  wal {
    max_keepalive_time = "2h"
  }
}

loki.write "central" {
  external_labels = { host = {{q .Host}} }

  endpoint {
    url = {{q (print .CentralURL "/ingest/loki/push")}}

    basic_auth {
      username = {{q .AgentName}}
      password = sys.env("OBSERVA_TOKEN")
    }
{{tlsConfig .TLS "    "}}
  }
}

otelcol.auth.basic "central" {
  username = {{q .AgentName}}
  password = sys.env("OBSERVA_TOKEN")
}

otelcol.exporter.otlphttp "central" {
  client {
    endpoint = {{q (print .CentralURL "/ingest/otlp")}}
    auth     = otelcol.auth.basic.central.handler
{{otlpTLS .TLS "    "}}
  }
}

// ---------------------------------------------------------------------------
// Container discovery: observa.enable=true label or `observa attach` rule
// ---------------------------------------------------------------------------

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "observa" {
  targets = discovery.docker.containers.targets
{{range .Attached}}
  // observa attach: {{.Container}} -> {{.Project}}/{{.Env}}/{{.Service}}
{{- range attachLabels .}}
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = {{q (print "/" (re .Container))}}
    target_label  = {{q .Label}}
    replacement   = {{q .Value}}
  }
{{- end}}
{{end}}
  rule {
    source_labels = ["__meta_docker_container_label_observa_enable"]
    regex         = "true"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observa_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observa_env"]
    target_label  = "env"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observa_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observa_preset"]
    target_label  = "preset"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// ---------------------------------------------------------------------------
// Logs of monitored containers
// ---------------------------------------------------------------------------

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.observa.output
  forward_to = [loki.write.central.receiver]
}

// ---------------------------------------------------------------------------
// Host metrics (+ thresholds and routing published by `observa apply`)
// ---------------------------------------------------------------------------

prometheus.exporter.unix "host" {
{{- if .Desktop}}
  // Docker Desktop: no access to the VM filesystem, container values.
{{- else}}
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
{{- end}}

  textfile {
    directory = "/etc/observa/textfile"
  }
}

// Alloy exporters label their targets job="integrations/<name>", which wins over
// job_name: every exporter scrape sets the job explicitly with a relabel rule.
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "observa/host"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.central.receiver]
  job_name        = "observa/host"
  scrape_interval = "15s"
}

prometheus.exporter.self "agent" { }

discovery.relabel "agent" {
  targets = prometheus.exporter.self.agent.targets

  rule {
    target_label = "job"
    replacement  = "observa/agent"
  }
}

prometheus.scrape "agent" {
  targets         = discovery.relabel.agent.output
  forward_to      = [prometheus.remote_write.central.receiver]
  job_name        = "observa/agent"
  scrape_interval = "60s"
}

// ---------------------------------------------------------------------------
// Container metrics (cAdvisor)
// ---------------------------------------------------------------------------

prometheus.exporter.cadvisor "containers" {
  docker_host            = "unix:///var/run/docker.sock"
  docker_only            = true
  store_container_labels = false
  allowlisted_container_labels = [
    "observa.enable", "observa.project", "observa.env", "observa.service", "observa.preset",
  ]
}

discovery.relabel "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "job"
    replacement  = "observa/containers"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  forward_to      = [prometheus.relabel.containers.receiver]
  job_name        = "observa/containers"
  scrape_interval = "15s"
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.central.receiver]
{{range .Attached}}
  // observa attach: {{.Container}}
{{- range attachMetricLabels .}}
  rule {
    source_labels = ["name"]
    regex         = {{q (re .Container)}}
    target_label  = {{q .Label}}
    replacement   = {{q .Value}}
  }
{{- end}}
{{end}}
  rule {
    source_labels = ["container_label_observa_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["container_label_observa_env"]
    target_label  = "env"
  }
  rule {
    source_labels = ["container_label_observa_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["container_label_observa_preset"]
    target_label  = "preset"
  }
  rule {
    source_labels = ["name"]
    target_label  = "container"
  }
  rule {
    regex  = "container_label_.*|id"
    action = "labeldrop"
  }
}

// ---------------------------------------------------------------------------
// Instrumented applications (OpenTelemetry, level 2): OTLP on the `observa` network
// ---------------------------------------------------------------------------

otelcol.receiver.otlp "apps" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.transform.labels.input]
    traces  = [otelcol.processor.batch.traces.input]
  }
}

// Copies the observa.* attributes set by `observa init` into standard labels.
otelcol.processor.transform "labels" {
  error_mode = "ignore"

  metric_statements {
    context    = "datapoint"
    statements = [
      `set(attributes["project"], resource.attributes["observa.project"]) where resource.attributes["observa.project"] != nil`,
      `set(attributes["env"], resource.attributes["observa.env"]) where resource.attributes["observa.env"] != nil`,
      `set(attributes["service"], resource.attributes["observa.service"]) where resource.attributes["observa.service"] != nil`,
      `set(attributes["preset"], resource.attributes["observa.preset"]) where resource.attributes["observa.preset"] != nil`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.metrics.input]
  }
}

otelcol.processor.batch "metrics" {
  output {
    metrics = [otelcol.exporter.prometheus.apps.input]
  }
}

otelcol.exporter.prometheus "apps" {
  forward_to          = [prometheus.remote_write.central.receiver]
  include_target_info = false
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlphttp.central.input]
  }
}
{{if .EBPF}}
// ---------------------------------------------------------------------------
// eBPF: HTTP traces without touching the code. HTTP metrics are derived from them
// by Tempo (span metrics), as for instrumented applications.
// ---------------------------------------------------------------------------
{{if .EBPFServices}}
beyla.ebpf "apps" {
  discovery {
{{- range .EBPFServices}}
    instrument {
      open_ports      = {{q (printf "%d" .Port)}}
      name            = {{q .Service}}
      namespace       = {{q (print .Project "." .Env)}}
      containers_only = true
    }
{{- end}}
  }

  routes {
    unmatched = "heuristic"
  }

  output {
    traces = [otelcol.processor.transform.ebpf.input]
  }
}

// Sets the observa.* attributes the central expects on eBPF traces.
otelcol.processor.transform "ebpf" {
  error_mode = "ignore"

  trace_statements {
    context    = "resource"
    statements = [
{{- range .EBPFServices}}
      {{ottl (printf "set(attributes[\"observa.project\"], %q) where attributes[\"service.name\"] == %q and attributes[\"service.namespace\"] == %q" .Project .Service (print .Project "." .Env))}},
      {{ottl (printf "set(attributes[\"observa.env\"], %q) where attributes[\"service.name\"] == %q and attributes[\"service.namespace\"] == %q" .Env .Service (print .Project "." .Env))}},
      {{ottl (printf "set(attributes[\"observa.service\"], %q) where attributes[\"service.name\"] == %q and attributes[\"service.namespace\"] == %q" .Service .Service (print .Project "." .Env))}},
{{- end}}
    ]
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}
{{else}}
// eBPF enabled but no service declared with `instrumentation: ebpf` (observa apply).
{{end}}{{end}}
{{range .Exporters}}
// ---------------------------------------------------------------------------
// {{.Kind}}: {{.Project}}/{{.Env}}/{{.Service}} ({{.Address}})
// ---------------------------------------------------------------------------
{{if eq .Kind "postgres"}}
prometheus.exporter.postgres {{q .ID}} {
  data_source_names = [sys.env({{q .SecretEnv}})]
}
{{else if eq .Kind "redis"}}
prometheus.exporter.redis {{q .ID}} {
  redis_addr = {{q .Address}}
{{- if .SecretEnv}}
  redis_password = sys.env({{q .SecretEnv}})
{{- end}}
  check_keys = ["celery"]
}
{{end}}
discovery.relabel {{q .ID}} {
  targets = prometheus.exporter.{{.Kind}}.{{.ID}}.targets

  rule {
    target_label = "project"
    replacement  = {{q .Project}}
  }
  rule {
    target_label = "env"
    replacement  = {{q .Env}}
  }
  rule {
    target_label = "service"
    replacement  = {{q .Service}}
  }
  rule {
    target_label = "preset"
    replacement  = {{q .Kind}}
  }
  rule {
    target_label = "job"
    replacement  = {{q (print "observa/" .Kind "/" .Project "/" .Env "/" .Service)}}
  }
}

prometheus.scrape {{q .ID}} {
  targets         = discovery.relabel.{{.ID}}.output
  forward_to      = [prometheus.remote_write.central.receiver]
  job_name        = {{q (print "observa/" .Kind "/" .Project "/" .Env "/" .Service)}}
  scrape_interval = "30s"
}
{{end}}
