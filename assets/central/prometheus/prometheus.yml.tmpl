# ObservaBoard central Prometheus — generated by `observa central install|reload`.
# Agents push their metrics via remote write (through Caddy); Prometheus
# only scrapes the central's own components here.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

storage:
  tsdb:
    retention:
      time: {{.Retention.Metrics}}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: observa-central
    static_configs:
      - targets: ["localhost:9090"]
        labels: { component: prometheus }
      - targets: ["alertmanager:9093"]
        labels: { component: alertmanager }
      - targets: ["loki:3100"]
        labels: { component: loki }
      - targets: ["tempo:3200"]
        labels: { component: tempo }
      - targets: ["grafana:3000"]
        labels: { component: grafana }
