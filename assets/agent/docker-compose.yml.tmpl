# ObservaBoard agent — generated by `observa agent install`.
# Do not edit by hand: run `observa agent install` or `observa agent reload` instead.
name: observa-agent

services:
  observa-agent:
    image: {{.Image}}
    container_name: observa-agent
    restart: unless-stopped
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy/data
      - --server.http.listen-addr=0.0.0.0:12345
    env_file: .env
    # cAdvisor reads the host's cgroups: the container must be privileged.
    privileged: true
{{- if .EBPF}}
    # eBPF: access to the host's process namespace.
    pid: host
{{- end}}
    volumes:
      # Directories (not single files): a reload (SIGHUP) sees the new config.
      - ./config:/etc/alloy:ro
      - ./textfile:/etc/observa/textfile:ro
      - alloy-data:/var/lib/alloy/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
{{- if not .Desktop}}
      - /:/rootfs:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
{{- end}}
    networks:
      - observa
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  alloy-data: {}

networks:
  observa:
    external: true
