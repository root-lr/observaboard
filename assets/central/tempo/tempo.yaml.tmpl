# ObservaBoard central Tempo (v3.1, single-binary mode) — generated by `observa central install|reload`.
# Tempo 3: no more ingester or compactor; retention is enforced by the backend-worker.
stream_over_http_enabled: true

server:
  http_listen_port: 3200
  log_level: warn

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"

backend_scheduler:
  provider:
    compaction:
      compaction:
        block_retention: {{.Retention.Traces}}

backend_worker:
  compaction:
    block_retention: {{.Retention.Traces}}

# Span metrics: HTTP metrics (throughput, errors, latency per route) and Celery
# metrics are computed here from traces. Unlike OpenTelemetry SDK metrics,
# they stay accurate with multi-process servers (gunicorn, uvicorn
# workers) regardless of language or source (SDK or eBPF).
metrics_generator:
  registry:
    external_labels:
      source: tempo
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://prometheus:9090/api/v1/write
        send_exemplars: false
  processor:
    span_metrics:
      dimensions:
        - http.request.method
        - http.route
        - http.response.status_code
        - db.system
      dimension_mappings:
        - name: project
          source_labels: [observa.project]
        - name: env
          source_labels: [observa.env]
    service_graphs:
      dimensions:
        - observa.project
        - observa.env

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

overrides:
  defaults:
    metrics_generator:
      processors: ["span-metrics", "service-graphs"]
    compaction:
      block_retention: {{.Retention.Traces}}

usage_report:
  reporting_enabled: false
