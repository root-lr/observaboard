# Grafana dashboard provider — generated by `observa central install|reload`.
# ObservaBoard dashboards are read-only: duplicate them to customize them.
apiVersion: 1

providers:
  - name: observaboard
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /var/lib/grafana/dashboards
      foldersFromFilesStructure: true
